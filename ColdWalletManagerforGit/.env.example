# .env.example — copy to .env and set values before running docker compose up
# Do NOT commit .env to version control.

# Environment name used in service.environment ECS field
SERVICE_ENVIRONMENT=development

# PostgreSQL password (referenced in compose.yaml as ${POSTGRES_PASSWORD})
POSTGRES_PASSWORD=secret

# Elasticsearch host reachable from Filebeat container
# Override if your ES is external to this compose stack
ELASTICSEARCH_HOST=elasticsearch:9200
