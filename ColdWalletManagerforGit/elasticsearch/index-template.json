{
  "index_patterns": ["reckon-logs-coldwalletmanagerforgit-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },

        "message": { "type": "match_only_text" },

        "log": {
          "properties": {
            "level":   { "type": "keyword" },
            "logger":  { "type": "keyword" },
            "thread":  { "type": "keyword" }
          }
        },

        "service": {
          "properties": {
            "name":        { "type": "keyword" },
            "version":     { "type": "keyword" },
            "environment": { "type": "keyword" }
          }
        },

        "event": {
          "properties": {
            "dataset":  { "type": "keyword" },
            "category": { "type": "keyword" },
            "action":   { "type": "keyword" },
            "outcome":  { "type": "keyword" },
            "duration_ms": { "type": "long" }
          }
        },

        "trace": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },

        "transaction": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },

        "host": {
          "properties": {
            "name": { "type": "keyword" },
            "ip":   { "type": "ip",      "ignore_malformed": true }
          }
        },

        "container": {
          "properties": {
            "name":  { "type": "keyword" },
            "id":    { "type": "keyword" },
            "image": {
              "properties": {
                "name": { "type": "keyword" }
              }
            },
            "labels": { "type": "flattened" }
          }
        },

        "error": {
          "properties": {
            "type":        { "type": "keyword" },
            "message":    { "type": "match_only_text" },
            "stack_trace": { "type": "match_only_text" }
          }
        },

        "http": {
          "properties": {
            "method":      { "type": "keyword" },
            "status_code": { "type": "integer" }
          }
        },

        "url": {
          "properties": {
            "path": { "type": "keyword" }
          }
        },

        "user": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },

        "source": {
          "properties": {
            "ip": { "type": "ip", "ignore_malformed": true }
          }
        },

        "postgresql": {
          "properties": {
            "database": {
              "properties": {
                "name": { "type": "keyword" }
              }
            },
            "session": {
              "properties": {
                "id":   { "type": "keyword" },
                "line": { "type": "keyword" }
              }
            },
            "transaction_id": { "type": "keyword" },
            "command_tag":    { "type": "keyword" },
            "sql_state_code": { "type": "keyword" }
          }
        },

        "vault": {
          "properties": {
            "request": {
              "properties": {
                "id":        { "type": "keyword" },
                "path":      { "type": "keyword" },
                "operation": { "type": "keyword" }
              }
            },
            "auth": {
              "properties": {
                "accessor": { "type": "keyword" }
              }
            }
          }
        }
      }
    }
  },
  "priority": 200,
  "_meta": {
    "description": "ECS index template for Cold Wallet Manager logs",
    "managed_by": "coldwalletmanager-project"
  }
}
